# Conexión con SmartPro
#
# Este sitio no tiene catálogo ni CRM propios: los planes, los precios, los
# pagos y los clientes potenciales viven en SmartPro y se consumen por su API.
# Sin estas variables el sitio se ve, pero sin planes y sin poder vender.

SMARTPRO_API_URL=https://smartpro.cl
SMARTPRO_SECRET_KEY=
SMARTPRO_WEBHOOK_SECRET=
SITE_URL=https://desarrolloweb.smartpro.cl

# Certificación directa de Webpay Plus.
TRANSBANK_VALIDATION_ENABLED=false
TRANSBANK_ENVIRONMENT=integration
TRANSBANK_COMMERCE_CODE=597055555532
# En producción usar el código propio y la API Key entregada por Transbank.
TRANSBANK_API_KEY=
